// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// TABLAS

/**
 * {id, title, link, imageUrl, isActive}
 */
model Banner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  link      String
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, title, slug, description, imageUrl, marketIds,isActive}
 */
model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  products  Product[]
  trainings Training[]

  marketIds String[] @db.ObjectId
  markets   Market[] @relation(fields: [marketIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, title, motto, slug, logoUrl, description, isActive,}
 */
model Market {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  motto       String?
  slug        String  @unique
  logoUrl     String
  description String?
  isActive    Boolean @default(true)

  categoryIds String[]   @db.ObjectId
  categories  Category[] @relation(fields: [categoryIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, title, categoryId, slug, description, content, imageUrl, isActive}
 */
model Training {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String
  description String
  content     String
  imageUrl    String?
  isActive    Boolean @default(true)

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String    @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING // Pendiente
  PROCESSING // En proceso
  SHIPPED // Enviado
  DELIVERED // Entregado
  CANCELED // Cancelado
}

enum PaymentStatus {
  UNPAID // No pagado
  PARTIAL // Pagado parcialmente
  PAID // Pagado
  REFUNDED // Reembolsado
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

//USER => ADMIN, USER, SUPPLIER, CUSTOMER, MODERATOR
enum UserRole {
  USER // Cliente que compra
  SUPPLIER // Proveedor/vendedor
  MODERATOR // Empleado que trabaja en la página
  ADMIN // Usuario general con privilegios globales
}

/**
 * {id, name, email, password, emailVerified, role, isActive,}
 */
model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String
  firstName     String?
  lastName      String?
  imageUrl      String?
  idDocument    String?
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false)

  // Verificación de correo
  verificationToken        String?
  verificationTokenExpires DateTime? // Fecha de expiración del token para la verificación

  // Recuperación de contraseña
  passwordResetToken        String?
  passwordResetTokenExpires DateTime?
  passwordChangedAt         DateTime?

  // Relaciones
  profile         UserProfile?
  supplierProfile SupplierProfile?
  staffProfile    StaffProfile?
  orders          Order[]
  sales           Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  // Campos específicos de clientes
  dateOfBirth   DateTime?
  address       String?
  city          String?
  country       String?
  zipCode       String?
  phone         String?
  loyaltyPoints Int       @default(0)

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, name, idDocument, codeSupplier, phone, profileImageUrl, email, role, address, contactPerson, contactPersonPhone, paymentTerms, notes, isActive,}
 */
model SupplierProfile {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  // Campos específicos de proveedores
  name               String
  codeSupplier       String  @unique
  phone              String
  logoUrl            String?
  address            String?
  contactPerson      String?
  contactPersonPhone String?
  paymentTerms       String?
  notes              String?
  isActive           Boolean @default(true)

  // Productos ofrecidos por el proveedor
  products Product[]

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, name, idDocument, codeUser, role, password, email, phone, address, dob, notes, workScope, imageUrl, isActive,}
 */
model StaffProfile {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  // Campos específicos de empleados
  codeUser  String    @unique
  phone     String
  address   String?
  dob       DateTime?
  notes     String?
  workScope String?
  imageUrl  String?
  isActive  Boolean   @default(true)

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, title, sku, slug, code, barcode, description, price, salePrice, quantity, stock, tags, hasDiscount, imageUrl, isActive, categoryId, userId,}
 */
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  sku         String?
  slug        String   @unique
  code        String   @unique
  barcode     String?
  description String?
  price       Float    @default(0.00)
  salePrice   Float?   @default(0.00)
  quantity    Int      @default(0)
  stock       Int      @default(0)
  tags        String[]
  imageUrl    String?
  isActive    Boolean  @default(true)
  hasDiscount Boolean  @default(false)

  orderItems OrderItem[]
  sales      Sale[]

  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId String?          @db.ObjectId
  user   SupplierProfile? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, title, code, expiryDate, isActive,}
 */
model Coupon {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  couponCode String
  expiryDate DateTime
  usageLimit Int      @default(0)
  value      Float    @default(0.00)
  isActive   Boolean  @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * {id, userId, firstName, lastName, emailAddress, phoneNumber, streetAddress, city, country, zipCode, discountAmount, shippingCost, subtotal, total, paymentStatus, paymentMethod, paymentToken, orderStatus, notes, createdAt, updatedAt}
 */
model Order {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String @unique

  firstName    String
  lastName     String
  emailAddress String?
  phoneNumber  String?

  streetAddress String
  city          String
  country       String
  province      String
  zipCode       String

  tax            Int   @default(0)
  subtotal       Float @default(0.00)
  discountAmount Float @default(0.00)
  shippingCost   Float @default(0.00)
  total          Float @default(0.00)

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(UNPAID)
  paymentToken  String?

  notes       String?
  orderStatus OrderStatus @default(PENDING)

  orderItems OrderItem[]
  sales      Sale[]

  couponId String? @db.ObjectId
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  code     String
  imageUrl String?
  brand    String?
  quantity Int     @default(0)
  price    Float   @default(0.00)
  total    Float   @default(0.00)

  vendorId String @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  productTitle    String
  productImageUrl String
  productQuantity Int     @default(0)
  productPrice    Float   @default(0.00)
  total           Float   @default(0.00)

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  vendorId String @db.ObjectId
  vendor   User   @relation(fields: [vendorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
